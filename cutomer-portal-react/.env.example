# ==============================================================================
# Customer Portal React Frontend - Environment Variables (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' for local development:
#      cp .env.example .env
# 2. For production, set VITE_API_BASE_URL to your backend API URL before running:
#      npm run build
# ==============================================================================

# Backend API Base URL
VITE_API_BASE_URL=http://localhost:8080

# Optional: WebSocket Base URL (if different from backend HTTP URL or behind a separate WS proxy)
# VITE_WS_URL=ws://localhost:8080
