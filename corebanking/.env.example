# ==============================================================================
# CoreBanking Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env' in local development:
#      cp .env.example .env
# 2. Update the values below with your local or staging credentials.
# 3. DO NOT commit your actual '.env' file to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Database Connection (MySQL)
DB_URL=jdbc:mysql://localhost:3306/corebanking?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_database_password

# JPA / Hibernate
JPA_SHOW_SQL=false
JPA_DDL_AUTO=none

# Data Seeding (false in production)
APP_SEED_ENABLED=false
APP_SEED_SAMPLE_DATA_ENABLED=false
APP_SEED_DEMO_DATA_ENABLED=false

# Security & Authentication Policies
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_DURATION_MINUTES=15
AUTH_REFRESH_TOKEN_VALIDITY_DAYS=1
PASSWORD_SETUP_EXPIRATION_MINUTES=30

# Customer Portal JWT Secret (Must be Base64-encoded string, >= 256 bits / 32 bytes decoded)
# Example generate: openssl rand -base64 32
JWT_SECRET=Y29yZWJhbmtpbmctand0LXNlY3JldC1rZXktMjAyNi1wcm9kdWN0aW9uLWdyYWRl
JWT_EXPIRATION=900000
JWT_ISSUER=corebanking

# Application Staff JWT Secret (Plain string, minimum 32 characters)
APP_JWT_SECRET=my-core-banking-secret-key-must-be-at-least-32-characters
APP_JWT_EXPIRATION=900000
APP_JWT_ISSUER=CoreBankingSystem

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=minibank
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend URL & CORS Allowed Origins (comma-separated)
FRONTEND_URL=http://localhost:5173
STAFF_FRONTEND_URL=http://localhost:8002
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Email SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_email_app_password

# Group 3 Payment Gateway Integration
GATEWAY_BASE_URL=http://localhost:8004
GATEWAY_INTERNAL_KEY=MMSPG-SEC-KEY-2026

# Jasper Reports
JASPER_REPORT_PATH=classpath:reports/

