<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="fee_revenue_report"
              pageWidth="595" pageHeight="842"
              columnWidth="555" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="StartDate" class="java.lang.String"/>
    <parameter name="EndDate" class="java.lang.String"/>
    <parameter name="FilterChannel" class="java.lang.String"/>
    <parameter name="LogoPath" class="java.io.InputStream" isForPrompting="false"/>

    <field name="transactionType" class="java.lang.String"/>
    <field name="channel" class="java.lang.String"/>
    <field name="transactionCount" class="java.lang.Long"/>
    <field name="totalVolume" class="java.math.BigDecimal"/>
    <field name="totalFeeRevenue" class="java.math.BigDecimal"/>
    <field name="avgFeePerTx" class="java.math.BigDecimal"/>

    <variable name="V_TOTAL_TX" class="java.lang.Long" calculation="Sum">
        <variableExpression><![CDATA[$F{transactionCount}]]></variableExpression>
    </variable>
    <variable name="V_TOTAL_VOLUME" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalVolume}]]></variableExpression>
    </variable>
    <variable name="V_TOTAL_FEE" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{totalFeeRevenue}]]></variableExpression>
    </variable>

    <title>
        <band height="70">
            <image onErrorType="Blank">
                <reportElement x="0" y="5" width="45" height="45"/>
                <imageExpression><![CDATA[$P{LogoPath}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="55" y="5" width="350" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Core Banking - Fee & Revenue Report]]></text>
            </staticText>
            <textField>
                <reportElement x="55" y="30" width="450" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{StartDate} + " to " + $P{EndDate} + " | Channel: " + $P{FilterChannel}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="0" y="0" width="130" height="22"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Transaction Type]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="130" y="0" width="90" height="22"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Channel]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="220" y="0" width="55" height="22"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Tx Count]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="275" y="0" width="100" height="22"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Volume]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="375" y="0" width="100" height="22"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Total Fee Revenue]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="475" y="0" width="80" height="22"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Avg Fee/Tx]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField textAdjust="StretchHeight">
                <reportElement x="0" y="0" width="130" height="18"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionType}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="130" y="0" width="90" height="18"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{channel}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0">
                <reportElement x="220" y="0" width="55" height="18"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionCount}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="275" y="0" width="100" height="18"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{totalVolume}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="375" y="0" width="100" height="18"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{totalFeeRevenue}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="475" y="0" width="80" height="18"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA[$F{avgFeePerTx}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="380" y="0" width="175" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="0" y="0" width="220" height="24"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <text><![CDATA[Grand Total:]]></text>
            </staticText>
            <textField evaluationTime="Report" pattern="#,##0">
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="220" y="0" width="55" height="24"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_TX}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report" pattern="#,##0.00">
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="275" y="0" width="100" height="24"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_VOLUME}]]></textFieldExpression>
            </textField>
            <textField evaluationTime="Report" pattern="#,##0.00">
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="375" y="0" width="100" height="24"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_FEE}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="475" y="0" width="80" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>
