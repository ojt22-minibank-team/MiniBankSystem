<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="large_transaction_report"
              orientation="Landscape"
              pageWidth="842" pageHeight="595"
              columnWidth="802" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20">

    <parameter name="StartDate" class="java.lang.String"/>
    <parameter name="EndDate" class="java.lang.String"/>
    <parameter name="Threshold" class="java.lang.String"/>
    <parameter name="TxType" class="java.lang.String"/>
    <parameter name="LogoPath" class="java.io.InputStream" isForPrompting="false"/>

    <field name="transactionRef" class="java.lang.String"/>
    <field name="transactionTime" class="java.time.LocalDateTime"/>
    <field name="transactionType" class="java.lang.String"/>
    <field name="channel" class="java.lang.String"/>
    <field name="amount" class="java.math.BigDecimal"/>
    <field name="sourceAccountNo" class="java.lang.String"/>
    <field name="sourceCustomerName" class="java.lang.String"/>
    <field name="destAccountNo" class="java.lang.String"/>
    <field name="destCustomerName" class="java.lang.String"/>
    <field name="riskLevel" class="java.lang.String"/>

    <variable name="V_TOTAL_VOLUME" class="java.math.BigDecimal" calculation="Sum">
        <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    </variable>

    <title>
        <band height="65">
            <image onErrorType="Blank">
                <reportElement x="0" y="5" width="45" height="45"/>
                <imageExpression><![CDATA[$P{LogoPath}]]></imageExpression>
            </image>
            <staticText>
                <reportElement x="55" y="5" width="450" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="16" isBold="true"/>
                </textElement>
                <text><![CDATA[Large Transaction & AML Compliance Report]]></text>
            </staticText>
            <textField>
                <reportElement x="55" y="30" width="550" height="16"/>
                <textElement>
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA["Period: " + $P{StartDate} + " to " + $P{EndDate} + " | Min Threshold: " + $P{Threshold} + " MMK | Type: " + $P{TxType}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="0" y="0" width="85" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Tx Reference]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="85" y="0" width="85" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Timestamp]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="170" y="0" width="80" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Type]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="250" y="0" width="70" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Channel]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="320" y="0" width="85" height="22"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Amount (MMK)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="405" y="0" width="75" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Source Acc]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="480" y="0" width="105" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Source Customer]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="585" y="0" width="75" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Dest Acc]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="660" y="0" width="75" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Dest Customer]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" backcolor="#E2E8F0" x="735" y="0" width="67" height="22"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#CBD5E1"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Risk Level]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="18">
            <textField>
                <reportElement x="0" y="0" width="85" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionRef}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="85" y="0" width="85" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionTime} != null ? $F{transactionTime}.toString() : ""]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="170" y="0" width="80" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{transactionType}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="250" y="0" width="70" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{channel}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="320" y="0" width="85" height="18"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="405" y="0" width="75" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{sourceAccountNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="480" y="0" width="105" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{sourceCustomerName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="585" y="0" width="75" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{destAccountNo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="660" y="0" width="75" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7"/></textElement>
                <textFieldExpression><![CDATA[$F{destCustomerName}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="735" y="0" width="67" height="18"/>
                <box leftPadding="3"><pen lineWidth="0.5" lineColor="#E2E8F0"/></box>
                <textElement verticalAlignment="Middle"><font size="7" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$F{riskLevel}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="627" y="0" width="175" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement>
                <textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="24">
            <staticText>
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="0" y="0" width="320" height="24"/>
                <box leftPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <text><![CDATA[Total Large Transactions Volume:]]></text>
            </staticText>
            <textField evaluationTime="Report" pattern="#,##0.00">
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="320" y="0" width="85" height="24"/>
                <box rightPadding="4"><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$V{V_TOTAL_VOLUME}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement mode="Opaque" backcolor="#FEF3C7" x="405" y="0" width="397" height="24"/>
                <box><pen lineWidth="0.5" lineColor="#F59E0B"/></box>
                <text><![CDATA[]]></text>
            </staticText>
        </band>
    </summary>
</jasperReport>